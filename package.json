{
  "name": "temperature-converter",
  "version": "1.0.0",
  "description": "Temperature conversion webservice",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "ts-node src/app.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "start:backend": "node dist/app.js",
    "start:frontend": "cd frontend && npm run dev",
    "dev:full": "concurrently \"npm run dev\" \"npm run start:frontend\"",
    "test:performance": "k6 run performance/tests/convert_api.js",
    "test:performance:smoke": "k6 run --scenario smoke_test performance/tests/convert_api.js",
    "test:performance:load": "k6 run --scenario load_test performance/tests/convert_api.js",
    "test:performance:stress": "k6 run --scenario stress_test performance/tests/convert_api.js",
    "test:performance:spike": "k6 run --scenario spike_test performance/tests/convert_api.js"
  },
  "keywords": [
    "temperature",
    "converter",
    "api",
    "express",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.0.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "@types/supertest": "^7.0.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "concurrently": "^10.0.3",
    "jest": "^30.0.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  }
}
